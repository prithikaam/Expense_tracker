# Copy this file to ".env" and put your own values in it. Never commit ".env".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_tracker
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Any long random text (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Set to 1 only while developing
FLASK_DEBUG=0
